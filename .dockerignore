# Keep the build context small → faster builds, smaller context tarball.
# Everything here is either regenerated or irrelevant to compilation.

# Build artifacts (regenerated inside the builder stage)
target/

# Docker artifacts
Dockerfile
docker-compose.yml
.dockerignore

# Version control & editor cruft
.git/
.gitignore
.zcode/

# Docs / site (not needed to compile the binary)
site/

# OS junk
.DS_Store
Thumbs.db

# Local env files (may contain secrets)
.env
.env.local
