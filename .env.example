# LiteLLM proxy authentication key (required for proxy clients).
LITELLM_MASTER_KEY=sk-change-me

# Provider model name, including its LiteLLM provider prefix.
# Examples: openai/gpt-4o-mini, ollama/qwen2.5:7b
LITELLM_MODEL=openai/gpt-4o-mini

# OpenAI-compatible upstream endpoint.
# For Ollama on the host: http://host.docker.internal:11434
LITELLM_API_BASE=https://api.openai.com/v1

# Upstream provider API key. Ollama can use any non-empty value.
LITELLM_API_KEY=sk-change-me
